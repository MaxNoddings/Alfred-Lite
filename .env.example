# ── The brain ────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com → API keys).
# Add a few dollars of credit; a full market day costs pennies.
ANTHROPIC_API_KEY=sk-ant-...

# ── Alpaca paper trading ─────────────────────────────────────
# Paper account keys (https://alpaca.markets → paper trading).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── Runtime ──────────────────────────────────────────────────
# Which broker drives trades: "sim" (offline dev) or "alpaca" (live paper).
BROKER=sim
